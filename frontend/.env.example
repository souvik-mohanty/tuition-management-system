# Public configuration only. Never put secrets (JWT, Razorpay secret, Firebase private key, DB/Redis/Kafka credentials) here.
VITE_API_BASE_URL=
VITE_USE_MOCK_API=true
# Defaults to VITE_USE_MOCK_API when unset. Set false to use real Firebase OTP login.
VITE_USE_MOCK_AUTH=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Google OAuth web client ID (public); create it in Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=
