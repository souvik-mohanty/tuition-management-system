# Copy to .env (git-ignored) and fill in. Never commit real values.
HTTP_PORT=80
DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
REDIS_PASSWORD=
FIREBASE_PROJECT_ID=tuition-management-syste-2d320
GOOGLE_CLIENT_ID=
# Origin(s) the browser loads the app from (only matters if the API is called cross-origin)
CORS_ALLOWED_ORIGINS=http://localhost
# SEED_OWNER_PHONE=+919000000001
