DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=<at least 32 random characters>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# true for hosted Redis that requires TLS (e.g. Upstash)
REDIS_SSL=false
FIREBASE_PROJECT_ID=tuition-management-syste-2d320
# Public Google OAuth web client ID (Google Cloud Console > Credentials). Not the client secret.
GOOGLE_CLIENT_ID=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# SEED_OWNER_PHONE=+919000000001
# DEMO ONLY: true lets any verified Google account sign in as any role. Never use with real data.
DEMO_MODE=false
